# Ferramentas internas
.claude/
_inline_check.js

# Logs e lixo de SO
*.log
.DS_Store
Thumbs.db

# ─── Credenciais — NUNCA commitar ────────────────────────────────
# Service accounts do Google (Firebase Admin, Cloud Functions, etc.)
# Wildcard nos 2 lados pra cobrir prefixos (ex: staging-service-account.json,
# dev-firebase-adminsdk.json) — o padrão antigo só com sufixo deixava
# variantes com prefixo passarem (auditoria #24).
**/*service-account*.json
**/*firebase-adminsdk*.json
**/*google-credentials*.json
**/*-key.json
**/*-secret.json

# Certificados ICP-Brasil / TLS / chaves privadas
*.p12
*.pfx
*.pem
*.key
*.crt
*.csr

# Variáveis de ambiente (podem conter API keys)
.env
.env.*
!.env.example

# Tokens diversos
**/token*.json
!**/manifest.json

# ─── Build outputs / dependências ────────────────────────────────
node_modules/
.vercel/
.next/
dist/
build/
