rules_version = '2';

// =====================================================================
// UC Jurídico — Firestore Security Rules
// =====================================================================
//
// Modelo: collection `users` é a allowlist; doc id = email (lowercase).
// Quem está em users/{email} com ativo=true pode ler o próprio doc
// mais collections de domínio CONFORME O role:
//
//   admin   → tudo (gerencia users também)
//   user    → tudo de domínio (não mexe em users nem audit)
//   viewer  → read-only em tudo de domínio
//   cliente → SÓ seus dados:
//             - users/{próprio email}
//             - processos onde clienteId/clienteIds bate
//             - clientes/{próprio clienteId}
//             - compromissos próprios (clienteId match)
//             - honorarios próprios (clienteId match)
//             Bloqueado em: prazos, eventos, notas, jurisprudência,
//             djen, comunicações, petições, financeiro interno,
//             settings, audit
//
// Cloud Functions (Admin SDK) bypassa rules — cron DJEN continua escrevendo.
//
// Pra mudar a rule e deployar:
//   firebase deploy --only firestore:rules                  (prod)
//   firebase deploy --only firestore:rules --project staging (staging)
//
// Documentação Firebase: https://firebase.google.com/docs/firestore/security/rules-structure

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // HELPERS
    // ============================================================

    function isSignedIn() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }

    function userEmail() {
      return request.auth.token.email.lower();
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(userEmail())).data;
    }

    function isAllowed() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(userEmail()))
        && userDoc().ativo == true;
    }

    function role() {
      return userDoc().role;
    }

    function isAdmin()   { return isAllowed() && role() == 'admin'; }
    function isCliente() { return isAllowed() && role() == 'cliente'; }

    // Pode escrever em collections de domínio (admin + user)
    function canWrite() {
      return isAllowed() && (role() == 'admin' || role() == 'user');
    }

    // Pode ler dados internos do escritório (admin + user + viewer)
    function isInternal() {
      return isAllowed() && (role() == 'admin' || role() == 'user' || role() == 'viewer');
    }

    // clienteId do user atual (null se não vinculado)
    function meuClienteId() {
      return userDoc().get('clienteId', '');
    }

    // Cliente está vinculado a este processo?
    // Cobre tanto clienteId (1:1 legado) quanto clienteIds[] (multi-cliente novo).
    function isProcDoCliente(p) {
      return isCliente()
        && meuClienteId() != ''
        && (p.get('clienteId', '') == meuClienteId()
            || meuClienteId() in p.get('clienteIds', []));
    }

    // Cliente está vinculado ao processo de ID `pid`? Faz lookup.
    // Custo: 1 read em /processos/{pid} por avaliação. Firestore faz cache
    // por path dentro de 1 request — se app fizer query
    // `where('processId', '==', X)` retornando N docs filhos, só 1 lookup
    // é cobrado (cache hit). Por isso o app DEVE filtrar por processId
    // quando role=cliente — sem filtro, Firestore tenta N lookups diferentes
    // e bate o limite de 10 reads em rules por query.
    function processoIdDoCliente(pid) {
      return isCliente()
        && meuClienteId() != ''
        && pid != null
        && pid != ''
        && exists(/databases/$(database)/documents/processos/$(pid))
        && isProcDoCliente(get(/databases/$(database)/documents/processos/$(pid)).data);
    }

    // ============================================================
    // users (allowlist)
    // ============================================================
    // Read aberto pra signedIn — precisa pra checar o próprio role.
    //
    // Write:
    //   - admin: gerencia qualquer doc (incluindo outros admins/users/viewers)
    //   - user:  gerencia APENAS docs com role='cliente' (libera acesso pra
    //            clientes do escritório) — não pode criar admins/users nem
    //            promover/rebaixar; não pode auto-criar
    //   - cliente/viewer: nada
    //
    // Bootstrap: o dono do escritório pode se criar como admin se ainda
    // não existir nenhum doc dele.
    match /users/{email} {
      allow read: if isSignedIn();
      allow create: if isAdmin()
        || (canWrite()
            && request.resource.data.role == 'cliente'
            && email != userEmail())
        || (isSignedIn()
            && email == userEmail()
            // Co-titularidade (#40): qualquer um dos dois pode fazer bootstrap
            // como admin. Manter em sync com api.js BOOTSTRAP_ADMIN_EMAILS.
            && userEmail() in ['eduardourany@uranydecastro.com.br', 'ucjuridico@uranydecastro.com.br']
            && request.resource.data.role == 'admin'
            && request.resource.data.ativo == true
            && !exists(/databases/$(database)/documents/users/$(userEmail())));
      // Update: admin tudo, user só docs onde tanto o doc atual quanto o
      // novo continuam role='cliente' (impede promoção via update).
      allow update: if isAdmin()
        || (canWrite()
            && resource.data.role == 'cliente'
            && request.resource.data.role == 'cliente');
      allow delete: if isAdmin();
    }

    // ============================================================
    // audit (log de ações)
    // ============================================================
    // Qualquer user autorizado (inclusive cliente) cria log próprio.
    // Só admin lê. Imutável.
    match /audit/{auditId} {
      allow create: if isAllowed()
        && request.resource.data.userEmail == userEmail();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // ============================================================
    // PROCESSOS
    // ============================================================
    // Cliente vê só processos vinculados via clienteId / clienteIds.
    match /processos/{id} {
      allow read: if isInternal() || isProcDoCliente(resource.data);
      allow create, update, delete: if canWrite();
    }

    // ============================================================
    // CLIENTES (cadastros)
    // ============================================================
    // Cliente vê só o próprio cadastro.
    match /clientes/{id} {
      allow read: if isInternal() || (isCliente() && id == meuClienteId());
      allow create, update, delete: if canWrite();
    }

    // ============================================================
    // COMPROMISSOS (agenda)
    // ============================================================
    // Cliente vê só os próprios.
    match /compromissos/{id} {
      allow read: if isInternal()
                  || (isCliente() && resource.data.get('clienteId', '') == meuClienteId());
      allow create, update, delete: if canWrite();
    }

    // ============================================================
    // HONORÁRIOS
    // ============================================================
    // Cliente vê só os próprios.
    match /honorarios/{id} {
      allow read: if isInternal()
                  || (isCliente() && resource.data.get('clienteId', '') == meuClienteId());
      allow create, update, delete: if canWrite();
    }

    // ============================================================
    // COLEÇÕES DE HISTÓRICO DO PROCESSO
    // ============================================================
    // Eventos (movimentos), prazos (publicações com data fatal) e djen
    // (publicações cruas) são informações do processo que cliente vê
    // legitimamente — não são interno-escritório. Rule libera SE o
    // processId está vinculado ao cliente (via lookup).

    match /eventos/{id} {
      allow read: if isInternal() || processoIdDoCliente(resource.data.processId);
      allow create, update, delete: if canWrite();
    }
    match /prazos/{id} {
      allow read: if isInternal() || processoIdDoCliente(resource.data.processId);
      allow create, update, delete: if canWrite();
    }
    match /djen/{hash} {
      allow read: if isInternal() || processoIdDoCliente(resource.data.get('processId', ''));
      allow create, update, delete: if canWrite();
    }

    // ============================================================
    // COLEÇÕES INTERNAS (cliente bloqueado)
    // ============================================================
    // Notas, jurisprudência, comunicações, petições — escritório.

    match /notas/{id}               { allow read: if isInternal(); allow create, update, delete: if canWrite(); }
    match /jurisprudencia/{id}      { allow read: if isInternal(); allow create, update, delete: if canWrite(); }
    match /comunicacoes/{id}        { allow read: if isInternal(); allow create, update, delete: if canWrite(); }
    match /peticao_modelos/{id}     { allow read: if isInternal(); allow create, update, delete: if canWrite(); }
    match /peticoes/{id}            { allow read: if isInternal(); allow create, update, delete: if canWrite(); }
    match /calculos/{id}            { allow read: if isInternal(); allow create, update, delete: if canWrite(); }
    match /custas/{id}              { allow read: if isInternal(); allow create, update, delete: if canWrite(); }

    // ============================================================
    // MÓDULO FINANCEIRO (cliente bloqueado)
    // ============================================================

    match /bancos/{id}          { allow read: if isInternal(); allow create, update, delete: if canWrite(); }
    match /cartoes/{id}         { allow read: if isInternal(); allow create, update, delete: if canWrite(); }
    match /categorias_fin/{id}  { allow read: if isInternal(); allow create, update, delete: if canWrite(); }
    match /transacoes/{id}      { allow read: if isInternal(); allow create, update, delete: if canWrite(); }
    match /recorrencias/{id}    { allow read: if isInternal(); allow create, update, delete: if canWrite(); }

    // ============================================================
    // SETTINGS
    // ============================================================
    // ATENÇÃO: settings/fcmTokens contém tokens de TODOS os users —
    // cliente NÃO pode ler isso. Bloqueio total pra cliente.
    match /settings/{chave} {
      allow read: if isInternal();
      allow create, update, delete: if canWrite();
    }

    // ============================================================
    // DEFAULT DENY
    // ============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
