rules_version = '2';

// UC Jurídico — Security Rules do Firestore.
// Modelo: collection `users` é a allowlist; doc id = email do usuário (lowercase).
// Quem está em users/{email} com ativo=true pode ler/escrever todas as outras
// collections. Apenas admins editam users.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }

    function userEmail() {
      return request.auth.token.email.lower();
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(userEmail())).data;
    }

    function isAllowed() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(userEmail()))
        && userDoc().ativo == true;
    }

    function isAdmin() {
      return isAllowed() && userDoc().role == 'admin';
    }

    // ====== Allowlist ======
    // Qualquer usuário autenticado pode ler (precisa para checar próprio acesso/role).
    // Só admin escreve, com uma exceção: o BOOTSTRAP_ADMIN se autocria no primeiro
    // login se ainda não existir nenhum doc com seu email.
    match /users/{email} {
      allow read: if isSignedIn();
      allow create: if isAdmin() || (
        // Bootstrap clause — só pega no primeiríssimo login do admin do escritório.
        isSignedIn()
        && email == userEmail()
        && userEmail() == 'eduardourany@uranydecastro.com.br'
        && request.resource.data.role == 'admin'
        && request.resource.data.ativo == true
        && !exists(/databases/$(database)/documents/users/$(userEmail()))
      );
      allow update, delete: if isAdmin();
    }

    // ====== Audit log ======
    // Qualquer usuário autorizado escreve (immutable). Só admin lê histórico.
    match /audit/{auditId} {
      allow create: if isAllowed()
        && request.resource.data.userEmail == userEmail();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // ====== Coleções de domínio ======
    match /clientes/{id} {
      allow read, create, update, delete: if isAllowed();
    }
    match /processos/{id} {
      allow read, create, update, delete: if isAllowed();
    }
    match /prazos/{id} {
      allow read, create, update, delete: if isAllowed();
    }
    match /eventos/{id} {
      allow read, create, update, delete: if isAllowed();
    }
    match /notas/{id} {
      allow read, create, update, delete: if isAllowed();
    }
    match /jurisprudencia/{id} {
      allow read, create, update, delete: if isAllowed();
    }
    match /djen/{hash} {
      allow read, create, update, delete: if isAllowed();
    }
    match /settings/{chave} {
      allow read, create, update, delete: if isAllowed();
    }

    // ====== Módulo Financeiro (v6.16+) ======
    match /bancos/{id} {
      allow read, create, update, delete: if isAllowed();
    }
    match /cartoes/{id} {
      allow read, create, update, delete: if isAllowed();
    }
    match /categorias_fin/{id} {
      allow read, create, update, delete: if isAllowed();
    }
    match /transacoes/{id} {
      allow read, create, update, delete: if isAllowed();
    }
    match /recorrencias/{id} {
      allow read, create, update, delete: if isAllowed();
    }
    match /honorarios/{id} {
      allow read, create, update, delete: if isAllowed();
    }
    match /comunicacoes/{id} {
      allow read, create, update, delete: if isAllowed();
    }
    match /compromissos/{id} {
      allow read, create, update, delete: if isAllowed();
    }

    // Negar tudo o que não estiver explicitamente acima.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
